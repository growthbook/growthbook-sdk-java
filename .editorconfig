root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4

[*.gradle]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# trailing spaces are significant in Markdown (hard line breaks)
[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
