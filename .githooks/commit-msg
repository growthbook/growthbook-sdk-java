#!/bin/sh
# Enforces Conventional Commits: release-please derives versions and the
# changelog from these messages (see .claude/rules/git-conventions.md).

msg_file="$1"
first_line=$(head -n1 "$msg_file")

case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if printf '%s' "$first_line" | grep -Eq '^(feat|fix|refactor|perf|docs|test|build|ci|chore|style|revert)(\([a-zA-Z0-9._/-]+\))?!?: .+'; then
  exit 0
fi

echo "commit-msg: not a Conventional Commit:" >&2
echo "  $first_line" >&2
echo "" >&2
echo "Expected: type(scope)?: summary" >&2
echo "Types: feat fix refactor perf docs test build ci chore style revert" >&2
echo "release-please derives releases from commit types (.claude/rules/git-conventions.md)." >&2
exit 1
